<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Nami.Controls.Osd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    IsHitTestVisible="False"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Margin="24,56,24,24"
    Opacity="0"
    Visibility="Collapsed">

    <Border x:Name="Panel" CornerRadius="8" Padding="14,10,16,10" MinWidth="160" MaxWidth="480"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" Grid.Column="0" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{StaticResource OverlayTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock x:Name="Text" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text" />
                <TextBlock x:Name="Detail" FontSize="12" Foreground="{StaticResource OverlaySubtleTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" MinHeight="3" Height="3" Width="180" HorizontalAlignment="Left"
                             Foreground="{StaticResource AccentBrush}" Background="#33FFFFFF" Visibility="Collapsed" />
                <!-- Screenshot preview (IINA 1.1+): the captured image with Delete / Reveal / Edit -->
                <StackPanel x:Name="ShotPanel" Spacing="8" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="#66FFFFFF" HorizontalAlignment="Left">
                        <Image x:Name="ShotImage" Width="240" Stretch="Uniform" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ShotDelete" Click="ShotDelete_Click" Padding="10,4" FontSize="12" />
                        <Button x:Name="ShotReveal" Click="ShotReveal_Click" Padding="10,4" FontSize="12" />
                        <Button x:Name="ShotEdit" Click="ShotEdit_Click" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

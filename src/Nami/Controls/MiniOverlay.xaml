<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Nami.Controls.MiniOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    IsTabStop="False">

    <!-- Picture-in-picture chrome: shown on hover only, over the whole video -->
    <Grid>
        <Rectangle VerticalAlignment="Top" Height="56" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle VerticalAlignment="Bottom" Height="56" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Button x:Name="ExitButton" Style="{StaticResource OscButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                Click="ExitButton_Click" ToolTipService.ToolTip="Back to the player window" AutomationProperties.Name="Back to the player window">
            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8A7;" />
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource OscButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                Click="CloseButton_Click" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8BB;" />
        </Button>

        <Button x:Name="PlayButton" Style="{StaticResource OscButton}" Width="56" Height="56" CornerRadius="28" Background="#66000000"
                HorizontalAlignment="Center" VerticalAlignment="Center" Click="PlayButton_Click"
                ToolTipService.ToolTip="Play / Pause" AutomationProperties.Name="Play / Pause">
            <FontIcon x:Name="PlayIcon" Style="{StaticResource OscIcon}" FontSize="26" Glyph="&#xE768;" />
        </Button>

        <Slider x:Name="SeekSlider" Style="{StaticResource OscSlider}" Minimum="0" Maximum="1" StepFrequency="0.000001"
                VerticalAlignment="Bottom" Margin="12,0,12,4" ValueChanged="SeekSlider_ValueChanged" />
    </Grid>
</UserControl>

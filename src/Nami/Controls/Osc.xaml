<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Nami.Controls.Osc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    IsTabStop="False">

    <Grid>
        <!-- Hover time / thumbnail tooltip above the seek bar -->
        <Border x:Name="SeekTip" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-30,0,0"
                Background="#E6202020" CornerRadius="6" Padding="4" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="10">
            <StackPanel Spacing="3">
                <Image x:Name="SeekThumb" Width="160" Stretch="Uniform" Visibility="Collapsed" />
                <TextBlock x:Name="SeekTipText" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Floating layout (IINA default): two rows in a rounded panel -->
        <Border x:Name="FloatingRoot" Width="480" Padding="14,8,14,8" CornerRadius="12"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="FloatingRow1" Grid.Row="0" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="VolumePanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource OscButton}" Click="MuteButton_Click" ToolTipService.ToolTip="ミュート" AutomationProperties.Name="ミュート">
                            <FontIcon x:Name="VolumeIcon" Style="{StaticResource OscIcon}" Glyph="&#xE767;" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource OscSlider}" Width="84" Minimum="0" Maximum="130" StepFrequency="1"
                                ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="LeftArrowButton" Style="{StaticResource OscButton}" Click="LeftArrowButton_Click" ToolTipService.ToolTip="遅く" AutomationProperties.Name="遅く">
                            <TextBlock Text="&#x23EA;" FontFamily="Segoe UI Symbol" FontSize="18" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource OscButton}" Width="40" Height="40" Click="PlayButton_Click" ToolTipService.ToolTip="再生 / 一時停止" AutomationProperties.Name="再生 / 一時停止">
                            <FontIcon x:Name="PlayIcon" Style="{StaticResource OscIcon}" FontSize="26" Glyph="&#xE768;" />
                        </Button>
                        <Button x:Name="RightArrowButton" Style="{StaticResource OscButton}" Click="RightArrowButton_Click" ToolTipService.ToolTip="速く" AutomationProperties.Name="速く">
                            <TextBlock Text="&#x23E9;" FontFamily="Segoe UI Symbol" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ToolbarPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Style="{StaticResource OscButton}" Click="SettingsButton_Click" ToolTipService.ToolTip="クイック設定" AutomationProperties.Name="クイック設定">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE9E9;" />
                        </Button>
                        <Button x:Name="PlaylistButton" Style="{StaticResource OscButton}" Click="PlaylistButton_Click" ToolTipService.ToolTip="プレイリスト" AutomationProperties.Name="プレイリスト">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8FD;" />
                        </Button>
                        <Button x:Name="MusicModeButton" Style="{StaticResource OscButton}" Click="MusicModeButton_Click" ToolTipService.ToolTip="ミュージックモード" AutomationProperties.Name="ミュージックモード">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8D6;" />
                        </Button>
                        <Button x:Name="PipButton" Style="{StaticResource OscButton}" Click="PipButton_Click" ToolTipService.ToolTip="ミニプレイヤー" AutomationProperties.Name="ミニプレイヤー">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xEE49;" />
                        </Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource OscButton}" Click="FullscreenButton_Click" ToolTipService.ToolTip="全画面" AutomationProperties.Name="全画面">
                            <FontIcon x:Name="FullscreenIcon" Style="{StaticResource OscIcon}" Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FloatingRow2" Grid.Row="1" ColumnSpacing="10" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00" FontSize="12" Foreground="{StaticResource OverlayTextBrush}"
                               VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" FontFamily="Segoe UI Variable Text" />
                    <Grid x:Name="SeekHost" Grid.Column="1">
                        <Slider x:Name="SeekSlider" Style="{StaticResource OscSlider}" Minimum="0" Maximum="1" StepFrequency="0.001"
                                VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged"
                                PointerMoved="SeekSlider_PointerMoved" PointerExited="SeekSlider_PointerExited" />
                        <!-- A-B loop markers -->
                        <Rectangle x:Name="LoopA" Width="2" Height="14" Fill="#FFFFC83D" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="LoopB" Width="2" Height="14" Fill="#FFFFC83D" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="DurationButton" Grid.Column="2" Style="{StaticResource OscButton}" Width="52" Height="24" Click="DurationButton_Click"
                            ToolTipService.ToolTip="残り時間に切替" AutomationProperties.Name="残り時間に切替">
                        <TextBlock x:Name="DurationText" Text="00:00" FontSize="12" Foreground="{StaticResource OverlayTextBrush}" MinWidth="40" FontFamily="Segoe UI Variable Text" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Bar layout (IINA "bottom" / "top"): one full-width row; controls are moved here in code -->
        <Border x:Name="BarRoot" Visibility="Collapsed" Padding="16,6" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="BarRow" ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>
    </Grid>
</UserControl>

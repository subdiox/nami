<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Nami.Controls.Osc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Nami.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    IsTabStop="False">

    <Grid>
        <!-- Hover time / thumbnail tooltip above the seek bar -->
        <Border x:Name="SeekTip" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-30,0,0"
                Background="#E6202020" CornerRadius="6" Padding="4" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="10">
            <StackPanel Spacing="3">
                <Image x:Name="SeekThumb" Width="160" Stretch="Uniform" Visibility="Collapsed" />
                <TextBlock x:Name="SeekTipText" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Floating layout (IINA default): two rows in a rounded panel -->
        <Border x:Name="FloatingRoot" Width="520" Padding="14,8,14,8" CornerRadius="8"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="FloatingRow1" Grid.Row="0" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="VolumePanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource OscButton}" Click="MuteButton_Click" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                            <FontIcon x:Name="VolumeIcon" Style="{StaticResource OscIcon}" Glyph="&#xE767;" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource OscSlider}" Width="84" Minimum="0" Maximum="130" StepFrequency="1"
                                ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource OscButton}" Click="PrevButton_Click" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE892;" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource OscButton}" Width="40" Height="40" Click="PlayButton_Click" ToolTipService.ToolTip="Play / Pause (Space)" AutomationProperties.Name="Play / Pause (Space)">
                            <FontIcon x:Name="PlayIcon" Style="{StaticResource OscIcon}" FontSize="26" Glyph="&#xE768;" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource OscButton}" Click="NextButton_Click" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>

                    <!-- Right cluster, in Windows Media Player order: speed, subtitles/audio, queue, mini player, full screen, more -->
                    <StackPanel x:Name="ToolbarPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="SpeedButton" Style="{StaticResource OscButton}" Width="44" Click="SpeedButton_Click" ToolTipService.ToolTip="Playback speed" AutomationProperties.Name="Playback speed">
                            <TextBlock x:Name="SpeedText" Text="1×" FontSize="12" FontFamily="Segoe UI Variable Text" Foreground="{StaticResource OverlayTextBrush}" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource OscButton}" Click="SettingsButton_Click" ToolTipService.ToolTip="Video, audio &amp; subtitles (Ctrl+Shift+S)" AutomationProperties.Name="Video, audio &amp; subtitles (Ctrl+Shift+S)">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE7F0;" />
                        </Button>
                        <Button x:Name="PlaylistButton" Style="{StaticResource OscButton}" Click="PlaylistButton_Click" ToolTipService.ToolTip="Playlist (Ctrl+Shift+P)" AutomationProperties.Name="Playlist (Ctrl+Shift+P)">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE90B;" />
                        </Button>
                        <Button x:Name="MusicModeButton" Style="{StaticResource OscButton}" Click="MusicModeButton_Click" ToolTipService.ToolTip="Music mode" AutomationProperties.Name="Music mode">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8D6;" />
                        </Button>
                        <Button x:Name="PipButton" Style="{StaticResource OscButton}" Click="PipButton_Click" ToolTipService.ToolTip="Mini player (Ctrl+Shift+M)" AutomationProperties.Name="Mini player (Ctrl+Shift+M)">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xEE49;" />
                        </Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource OscButton}" Click="FullscreenButton_Click" ToolTipService.ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen (F11)">
                            <FontIcon x:Name="FullscreenIcon" Style="{StaticResource OscIcon}" Glyph="&#xE740;" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource OscButton}" Click="MoreButton_Click" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                            <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FloatingRow2" Grid.Row="1" ColumnSpacing="10" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00" FontSize="12" Foreground="{StaticResource OverlayTextBrush}"
                               VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" FontFamily="Segoe UI Variable Text" />
                    <Grid x:Name="SeekHost" Grid.Column="1">
                        <Slider x:Name="SeekSlider" Style="{StaticResource OscSlider}" Minimum="0" Maximum="1" StepFrequency="0.000001"
                                VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged"
                                PointerMoved="SeekSlider_PointerMoved" PointerExited="SeekSlider_PointerExited" />
                        <!-- A-B loop markers -->
                        <Rectangle x:Name="LoopA" Width="2" Height="14" Fill="#FFFFC83D" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="LoopB" Width="2" Height="14" Fill="#FFFFC83D" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="DurationButton" Grid.Column="2" Style="{StaticResource OscButton}" Width="52" Height="24" Click="DurationButton_Click"
                            ToolTipService.ToolTip="Show remaining time" AutomationProperties.Name="Show remaining time">
                        <TextBlock x:Name="DurationText" Text="00:00" FontSize="12" Foreground="{StaticResource OverlayTextBrush}" MinWidth="40" FontFamily="Segoe UI Variable Text" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Bar layout (IINA "bottom" / "top"): one full-width row; controls are moved here in code -->
        <Border x:Name="BarRoot" Visibility="Collapsed" Padding="16,6" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="BarRow" ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Nami.OnlineSubtitlesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Nami.Services"
    mc:Ignorable="d"
    Title="オンライン字幕を検索"
    PrimaryButtonText="ダウンロードして使う"
    CloseButtonText="閉じる"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnDownload">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ResultTemplate" x:DataType="services:SubtitleSearchResult">
            <StackPanel Padding="0,4">
                <TextBlock Text="{x:Bind Display}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid Width="560" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- credentials (shown until an API key is stored) -->
        <StackPanel x:Name="CredentialsPanel" Grid.Row="0" Spacing="6" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontSize="12">
                <Run Text="OpenSubtitles.com の無料アカウントと API キーが必要です。" />
                <Hyperlink NavigateUri="https://www.opensubtitles.com/consumers">API キーを取得</Hyperlink>
            </TextBlock>
            <TextBox x:Name="ApiKeyBox" Header="API キー" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UserBox" Grid.Column="0" Header="ユーザー名" />
                <PasswordBox x:Name="PasswordBox" Grid.Column="1" Header="パスワード" />
            </Grid>
            <Button Content="保存" Click="SaveCredentials_Click" HorizontalAlignment="Right" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Grid.Column="0" Header="検索語" KeyDown="QueryBox_KeyDown" />
            <TextBox x:Name="LanguagesBox" Grid.Column="1" Header="言語" Text="ja,en" />
            <Button x:Name="SearchButton" Grid.Column="2" Content="検索" VerticalAlignment="Bottom" Click="Search_Click" />
        </Grid>

        <ProgressBar x:Name="Busy" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" />

        <ListView x:Name="Results" Grid.Row="3" ItemTemplate="{StaticResource ResultTemplate}" SelectionMode="Single"
                  MaxHeight="320" MinHeight="120" SelectionChanged="Results_SelectionChanged" />

        <TextBlock x:Name="Status" Grid.Row="4" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
    </Grid>
</ContentDialog>

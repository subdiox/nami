<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Nami</RootNamespace>
    <AssemblyName>Nami</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged, self-contained: no MSIX, no Windows App SDK runtime installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>true</SelfContained>

    <!-- Native AOT for Release publish; Debug stays JIT for fast iteration. -->
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <DisableRuntimeMarshalling>false</DisableRuntimeMarshalling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- libmpv: copied next to the executable. -->
  <ItemGroup>
    <None Include="..\..\third_party\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    dotnet publish (Native AOT) leaves the app's PRI / XBF XAML resources out of the
    publish folder, and the app then fails with "Cannot locate resource from
    ms-appx:///MainWindow.xaml". Add them explicitly.
  -->
  <Target Name="NamiPublishXamlResources" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="Build">
    <ItemGroup>
      <_NamiPri Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
      <_NamiXbf Include="$(IntermediateOutputPath)**\*.xbf" Exclude="$(IntermediateOutputPath)embed\**" />
      <ResolvedFileToPublish Include="@(_NamiPri)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_NamiXbf)" RelativePath="%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>

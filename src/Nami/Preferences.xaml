<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Nami.Preferences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="環境設定"
    PrimaryButtonText="保存"
    CloseButtonText="閉じる"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSave">

    <ScrollViewer MaxHeight="560" Width="560">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SectionHeader}" Text="一般" Margin="0,0,0,6" />
            <ToggleSwitch x:Name="ResizeSwitch" Header="ファイルを開いたとき動画のサイズに合わせてウィンドウを調整する" />
            <ToggleSwitch x:Name="RememberVolumeSwitch" Header="音量を記憶する" />
            <ToggleSwitch x:Name="ResumeSwitch" Header="前回の再生位置から再開する" />
            <ToggleSwitch x:Name="AutoLoadFolderSwitch" Header="同じフォルダーのファイルを自動的にプレイリストへ追加する" />
            <ToggleSwitch x:Name="HistorySwitch" Header="再生履歴を記録する" />
            <ToggleSwitch x:Name="ThumbnailSwitch" Header="シークバーにサムネイルを表示する（バックグラウンドで生成）" />
            <ToggleSwitch x:Name="AutoMusicSwitch" Header="音声ファイルを開いたら自動的にミュージックモードにする" />
            <ComboBox x:Name="OscLayoutCombo" Header="コントローラー (OSC) の配置" HorizontalAlignment="Stretch">
                <x:String>フローティング（既定）</x:String>
                <x:String>下部バー</x:String>
                <x:String>上部バー</x:String>
            </ComboBox>

            <TextBlock Style="{StaticResource SectionHeader}" Text="字幕の見た目" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="SubFontCombo" Grid.Row="0" Grid.Column="0" Header="フォント" IsEditable="True" HorizontalAlignment="Stretch" />
                <Slider x:Name="SubSizeSlider" Grid.Row="0" Grid.Column="1" Header="サイズ" Minimum="16" Maximum="100" StepFrequency="1" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="SubBoldCheck" Content="太字" />
                    <CheckBox x:Name="SubItalicCheck" Content="斜体" />
                </StackPanel>
                <ComboBox x:Name="SubBorderStyleCombo" Grid.Row="1" Grid.Column="1" Header="縁取りの種類" HorizontalAlignment="Stretch">
                    <x:String>縁取りと影</x:String>
                    <x:String>不透明の箱</x:String>
                    <x:String>背景の箱</x:String>
                </ComboBox>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SubColorButton" Content="文字色" Click="SubColor_Click" Tag="text" />
                    <Button x:Name="SubOutlineColorButton" Content="縁の色" Click="SubColor_Click" Tag="outline" />
                    <Button x:Name="SubBackColorButton" Content="背景色" Click="SubColor_Click" Tag="back" />
                </StackPanel>
                <Slider x:Name="SubOutlineSlider" Grid.Row="2" Grid.Column="1" Header="縁の太さ" Minimum="0" Maximum="10" StepFrequency="0.5" />
                <Slider x:Name="SubShadowSlider" Grid.Row="3" Grid.Column="0" Header="影のオフセット" Minimum="0" Maximum="10" StepFrequency="0.5" />
                <ComboBox x:Name="SubCodepageCombo" Grid.Row="3" Grid.Column="1" Header="文字エンコーディング" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="SubAssOverrideCombo" Grid.Row="4" Grid.Column="0" Header="ASS 字幕のスタイル" HorizontalAlignment="Stretch">
                    <x:String>字幕ファイルのスタイルを使う</x:String>
                    <x:String>この設定で上書きする（yes）</x:String>
                    <x:String>サイズのみ合わせる（scale）</x:String>
                    <x:String>強制的に上書き（force）</x:String>
                    <x:String>装飾を取り除く（strip）</x:String>
                </ComboBox>
                <HyperlinkButton Grid.Row="4" Grid.Column="1" Content="既定に戻す" Click="SubStyleReset_Click" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock x:Name="SubLangHeader" Text="オンライン字幕の言語（カンマ区切り）" FontSize="12" Margin="0,8,0,0" />
            <TextBox x:Name="SubLanguagesBox" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="スクリーンショット" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScreenshotDirBox" Grid.Column="0" Header="保存先（空欄でピクチャ）" />
                <Button Grid.Column="1" Content="参照…" VerticalAlignment="Bottom" Click="BrowseScreenshotDir_Click" />
                <ComboBox x:Name="ScreenshotFormatCombo" Grid.Column="2" Header="形式" HorizontalAlignment="Stretch">
                    <x:String>png</x:String>
                    <x:String>jpg</x:String>
                    <x:String>webp</x:String>
                    <x:String>jxl</x:String>
                </ComboBox>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="オンライン動画 (yt-dlp)" />
            <TextBlock x:Name="YtDlpStatus" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="YtDlpInstallButton" Content="yt-dlp をダウンロード / 更新" Click="YtDlpInstall_Click" />
                <ProgressBar x:Name="YtDlpProgress" Width="160" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <ComboBox x:Name="YtdlFormatCombo" Header="画質" HorizontalAlignment="Stretch" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Windows との連携" />
            <TextBlock x:Name="AssocStatus" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RegisterButton" Content="メディアアプリとして登録" Click="Register_Click" />
                <Button x:Name="UnregisterButton" Content="登録を解除" Click="Unregister_Click" />
                <HyperlinkButton Content="既定のアプリ設定を開く" NavigateUri="ms-settings:defaultapps" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OverlaySubtleTextBrush}"
                       Text="登録するとエクスプローラーの「プログラムから開く」と Windows の「既定のアプリ」に Nami が表示され、namiplayer:// リンクも開けるようになります。既定にするには Windows の設定から選んでください。" />
            <TextBlock Text="ブラウザーから開く（ブックマークレット）" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="BookmarkletBox" IsReadOnly="True" FontSize="11" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                     Text="javascript:location.href='namiplayer://open?url='+encodeURIComponent(location.href)" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OverlaySubtleTextBrush}"
                       Text="上の 1 行をブックマークの URL に登録すると、見ているページを Nami で開けます（yt-dlp 対応サイト）。" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="mpv 設定" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OverlaySubtleTextBrush}">
                <Run Text="mpv.conf と input.conf をここで編集できます。mpv.conf の変更は保存時に可能な限り即時反映され、次回起動時に完全に適用されます。" />
            </TextBlock>
            <HyperlinkButton x:Name="OpenConfigFolder" Content="設定フォルダーを開く" Click="OpenConfigFolder_Click" Padding="0" />
            <TextBlock Text="mpv.conf" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
            <TextBox x:Name="MpvConfBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="180"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsSpellCheckEnabled="False" />
            <Button Content="キー操作をカスタマイズ…" Click="KeyBindings_Click" Margin="0,8,0,0" />
            <TextBlock Text="input.conf" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
            <TextBox x:Name="InputConfBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="140"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsSpellCheckEnabled="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

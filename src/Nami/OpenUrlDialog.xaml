<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Nami.OpenUrlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="URL を開く"
    PrimaryButtonText="開く"
    SecondaryButtonText="プレイリストに追加"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <StackPanel Width="520" Spacing="10">
        <TextBox x:Name="UrlBox" PlaceholderText="https://…  (動画ファイル、配信、YouTube などのページ)" TextChanged="UrlBox_TextChanged" />
        <StackPanel x:Name="YtDlpPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="YtDlpText" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
            <ProgressBar x:Name="YtDlpProgress" Visibility="Collapsed" />
            <Button x:Name="YtDlpButton" Content="yt-dlp をダウンロード" Click="YtDlpButton_Click" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

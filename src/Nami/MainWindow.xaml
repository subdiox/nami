<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Nami.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Nami.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nami"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Nami"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark">

        <!-- IINA-style title bar: transparent, floats over the video, fades with the OSC. -->
        <Grid x:Name="TitleOverlay" VerticalAlignment="Top" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.ColumnSpan="3" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Drag region (also carries the centered title) -->
            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent" />
            <TextBlock x:Name="TitleText" Grid.ColumnSpan="3" Text="Nami" FontSize="13" Foreground="#F2FFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Height="32" Padding="0,8,0,0" TextTrimming="CharacterEllipsis" Margin="160,0" IsHitTestVisible="False" />

            <!-- Same 32px row as the system caption buttons, so the icons line up with minimize / maximize / close. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Height="32" Margin="0,0,4,0">
                <Button x:Name="PinButton" Style="{StaticResource OscButton}" Visibility="Collapsed" Click="PinButton_Click" ToolTipService.ToolTip="Turn off always on top" AutomationProperties.Name="Turn off always on top">
                    <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE718;" />
                </Button>
                <Button Style="{StaticResource OscButton}" Click="PreferencesButton_Click" ToolTipService.ToolTip="Preferences" AutomationProperties.Name="Preferences">
                    <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE713;" />
                </Button>
                <Button Style="{StaticResource OscButton}" Click="SettingsButton_Click" ToolTipService.ToolTip="Quick settings" AutomationProperties.Name="Quick settings">
                    <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE9E9;" />
                </Button>
                <Button Style="{StaticResource OscButton}" Click="PlaylistButton_Click" ToolTipService.ToolTip="Playlist" AutomationProperties.Name="Playlist">
                    <FontIcon Style="{StaticResource OscIcon}" Glyph="&#xE8FD;" />
                </Button>
            </StackPanel>

            <!-- Caption buttons drawn by us (the system title bar is off) so they fade together with the HUD. -->
            <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Height="32">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click" ToolTipService.ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <FontIcon Style="{StaticResource CaptionIcon}" Glyph="&#xE921;" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click" ToolTipService.ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <FontIcon x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Glyph="&#xE922;" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseButton_Click" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B32A1B" />
                    </Button.Resources>
                    <FontIcon Style="{StaticResource CaptionIcon}" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

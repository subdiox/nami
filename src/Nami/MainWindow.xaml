<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Nami.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Nami.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nami"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Nami"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RequestedTheme="Dark">

        <!-- IINA-style title bar: transparent, floats over the video, fades with the OSC. -->
        <Grid x:Name="TitleOverlay" VerticalAlignment="Top" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Drag region. Windows 11 style: app icon + title at the left, nothing else but the caption buttons. -->
            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent" />
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Height="32" Margin="12,0,0,0" IsHitTestVisible="False">
                <Image Source="Assets/AppIcon.png" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="Nami" FontSize="12" Foreground="#F2FFFFFF" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600" />
            </StackPanel>

            <!-- Caption buttons drawn by us (the system title bar is off) so they fade together with the HUD. -->
            <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="32">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click" ToolTipService.ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <FontIcon Style="{StaticResource CaptionIcon}" Glyph="&#xE921;" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click" ToolTipService.ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen (F11)">
                    <FontIcon x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Glyph="&#xE922;" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseButton_Click" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B32A1B" />
                    </Button.Resources>
                    <FontIcon Style="{StaticResource CaptionIcon}" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

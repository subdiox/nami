<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nami.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Nami.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Nami.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    Background="Black">

    <Grid x:Name="Root">
        <!-- Host grid: the panel inside keeps the buffer's size and is scaled to this host while a resize is in flight. -->
        <Grid x:Name="VideoHost">
            <controls:VideoView x:Name="Video" />
        </Grid>
        <!-- Transparent input surface over the video (SwapChainPanel itself has no background). -->
        <controls:CursorSurface x:Name="Surface" Background="Transparent" />

        <!-- Empty state (IINA shows a drop hint when nothing is open) -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE714;" FontSize="56" Foreground="#40FFFFFF" />
            <TextBlock Text="{l:Tr Text='Drop a video here'}" Foreground="#80FFFFFF" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Text='Ctrl+O to open a file'}" Foreground="#50FFFFFF" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Bottom gradient behind the OSC -->
        <Rectangle x:Name="BottomShade" VerticalAlignment="Bottom" Height="140" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#66000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <controls:Osd x:Name="Osd" />

        <controls:Osc x:Name="Osc" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" />

        <controls:MusicPanel x:Name="Music" VerticalAlignment="Bottom" Visibility="Collapsed" />

        <controls:MiniOverlay x:Name="Mini" Visibility="Collapsed" />

        <!-- Update notice (IINA: "a new version is available"), top right under the title bar -->
        <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" IsClosable="True" RequestedTheme="Dark"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,48,16,0" MaxWidth="460"
                 Background="{StaticResource PanelBrush}" Closed="UpdateBar_Closed">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateDownload" Click="UpdateDownload_Click" />
            </InfoBar.ActionButton>
            <HyperlinkButton x:Name="UpdateSkip" Click="UpdateSkip_Click" Padding="0" Margin="0,0,0,8" />
        </InfoBar>

        <controls:Sidebar x:Name="Sidebar" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed">
            <controls:Sidebar.RenderTransform>
                <TranslateTransform x:Name="SidebarTransform" X="360" />
            </controls:Sidebar.RenderTransform>
        </controls:Sidebar>
    </Grid>
</Page>

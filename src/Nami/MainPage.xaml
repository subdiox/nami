<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nami.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nami"
    xmlns:controls="using:Nami.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    IsTabStop="True"
    Background="Black">

    <Grid>
        <controls:VideoView x:Name="Video" />

        <!-- Temporary transport bar; the real OSC comes later. -->
        <Border x:Name="Transport"
                VerticalAlignment="Bottom"
                Margin="16"
                Padding="12,8"
                CornerRadius="8"
                Background="#B3202020">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenButton" Grid.Column="0" Click="OpenButton_Click" ToolTipService.ToolTip="Open">
                    <FontIcon Glyph="&#xE8E5;" />
                </Button>
                <Button x:Name="PlayPauseButton" Grid.Column="1" Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
                </Button>
                <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Foreground="White"
                           FontFamily="Consolas" Text="0:00 / 0:00" MinWidth="110" />
                <Slider x:Name="SeekSlider" Grid.Column="3" VerticalAlignment="Center"
                        Minimum="0" Maximum="1000" StepFrequency="1" IsThumbToolTipEnabled="False"
                        ValueChanged="SeekSlider_ValueChanged" />
                <TextBlock x:Name="StatusText" Grid.Column="4" VerticalAlignment="Center" Foreground="#AAAAAA"
                           FontSize="12" Text="" />
            </Grid>
        </Border>
    </Grid>
</Page>
